# Local development
DEBUG=True
SECRET_KEY=replace-this-with-a-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production database. Leave blank locally to use SpatiaLite.
DATABASE_URL=

# Optional AI layer. Keep disabled for the first deployment.
AI_EXPLANATIONS_ENABLED=false
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=2000
AI_TIMEOUT_SECONDS=30
AI_BASE_URL=

# Optional RAG layer. Keep disabled for the first deployment.
RAG_ENABLED=false
RAG_CHROMA_PATH=
RAG_COLLECTION_NAME=sti_knowledge
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=3
RAG_MIN_SCORE=0.35
