# ---------------------------------------------------------------------------
# STI-PREDICTIVE-MODEL environment configuration
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored and
# must never be committed.
#
#     cp .env.example .env
#
# The ML prediction engine needs NONE of these. Every variable below only
# affects the optional AI explanation layer -- if they are absent, missing or
# wrong, /api/predictions/predict keeps working exactly as before.
# ---------------------------------------------------------------------------

# Master switch for the AI explanation layer. Set to false to disable the
# feature entirely without removing the API key.
AI_EXPLANATIONS_ENABLED=true

# Which LLM provider implementation to use. See ai_service/providers/__init__.py
# for the registered names.
AI_PROVIDER=anthropic

# Provider credentials. Required when AI_PROVIDER=anthropic.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model identifier passed to the provider.
AI_MODEL=claude-opus-5

# Generation limits.
AI_MAX_TOKENS=2000
AI_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Option B: local, open-source models via Ollama (no API key, no account)
#
# Install Ollama from https://ollama.com/download, then pull a model:
#
#     ollama pull llama3.2:3b      # ~2 GB, faster, lower quality
#     ollama pull qwen2.5:7b       # ~4.7 GB, slower, better quality
#
# Then switch the provider over:
#
#     AI_PROVIDER=ollama
#     AI_MODEL=llama3.2:3b
#     AI_TIMEOUT_SECONDS=180
#
# Leave ANTHROPIC_API_KEY empty -- Ollama requires no credentials, and the
# configuration checks know that this provider does not need one.
#
# Raise AI_TIMEOUT_SECONDS well above the default 30: on a CPU-only machine a
# 3B model takes roughly 30s per explanation and a 7B model 1-2 minutes.

# Ollama server address. Blank uses http://localhost:11434.
AI_BASE_URL=
